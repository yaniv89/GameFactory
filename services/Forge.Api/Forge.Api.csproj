<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Forge.Api</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forge.Domain\Forge.Domain.csproj" />
    <ProjectReference Include="..\Forge.Infrastructure\Forge.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Forge.Api's own endpoint code (Features/Auth/*.cs) calls
    HttpContext.GetOpenIddictServerRequest() and OpenIddict.Abstractions
    types directly, not just through Forge.Infrastructure's DI wiring —
    an explicit reference here, not an assumption that
    Forge.Infrastructure's OpenIddict.AspNetCore package reference flows
    through the ProjectReference far enough for this project's own
    compilation to see it.
  -->
  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.6.0" />
  </ItemGroup>

  <!--
    The `dotnet ef` CLI tools require their Design package on the startup
    project specifically (Forge.Api here) — Forge.Infrastructure's own
    reference to it has PrivateAssets="all", which is exactly why it
    doesn't flow transitively to whichever project is used to run the
    tools. Design-time only (PrivateAssets="all" again): never a runtime
    dependency of the shipped app.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Lets Forge.Tests construct a CurrentUser with known values directly
    (its setters are internal on purpose — only CurrentUserMiddleware
    should write them at runtime; this is a compile-time-only visibility
    grant for testing WorkspaceRoleHandler in isolation, not a runtime
    security boundary CLAUDE.md Section 1.1 would apply to).
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Forge.Tests" />
  </ItemGroup>

</Project>
