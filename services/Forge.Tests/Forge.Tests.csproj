<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Forge.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Package versions confirmed to exist on nuget.org at scaffold time (this
    environment has no .NET SDK, so `dotnet restore` itself is unverified —
    see the CI workflow, which runs the real restore/build/test on a
    GitHub-hosted runner that has the SDK).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.29" />
    <!-- M7 Phase 1: drives a real HubConnection against CollabHub over WebApplicationFactory's TestServer (LongPolling transport — TestServer's handler-based pipeline doesn't support a real WebSocket upgrade). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.29" />
    <!-- 4.14.0, not 4.13.0: pulls in SSH.NET >= 2026.0.0 transitively, fixing CVE-2026-48798 (GHSA-q939-rpr3-3284, path traversal in ScpClient.Download — SSH.NET is Testcontainers' own dependency for the Docker-over-SSH connection mode, unrelated to what these tests actually use it for). No SSH.NET 2025.1.0 patch exists; 2026.0.0 is the fix. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.14.0" />
    <PackageReference Include="Testcontainers.Azurite" Version="4.14.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forge.Domain\Forge.Domain.csproj" />
    <ProjectReference Include="..\Forge.Infrastructure\Forge.Infrastructure.csproj" />
    <ProjectReference Include="..\Forge.Api\Forge.Api.csproj" />
    <ProjectReference Include="..\Forge.Functions.Scan\Forge.Functions.Scan.csproj" />
  </ItemGroup>

</Project>
